name: 生成贡献图贪吃蛇

# 把贡献格子做成贪吃蛇动画，推到 output 分支，README 里按 raw 链接引用。
# 手动跑：仓库 Actions 页 → 本工作流 → Run workflow（或 gh workflow run snake.yml）

on:
  schedule:
    - cron: "0 21 * * *" # 每天 05:00（北京时间）更新一次
  workflow_dispatch:
  push:
    branches: [main]

jobs:
  generate:
    runs-on: ubuntu-latest
    timeout-minutes: 5
    permissions:
      contents: write
    steps:
      - name: 生成 svg（亮/暗两版）
        uses: Platane/snk/svg-only@v3
        with:
          github_user_name: ${{ github.repository_owner }}
          outputs: |
            dist/github-contribution-grid-snake.svg
            dist/github-contribution-grid-snake-dark.svg?palette=github-dark

      - name: 推到 output 分支
        uses: crazy-max/ghaction-github-pages@v3.1.0
        with:
          target_branch: output
          build_dir: dist
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
